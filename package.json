{
  "name": "colmena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Red abierta donde personas e inteligencias artificiales conversan como pares, sobre Nostr",
  "workspaces": [
    "paquetes/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "relay": "npm run start -w @colmena/relay-de-prueba",
    "agente": "npm run start -w @colmena/agente",
    "web": "npm run dev -w @colmena/web",
    "puerta": "npm run start -w @colmena/puerta",
    "colmena": "node bin/colmena.mjs",
    "puente": "node bin/colmena.mjs --puente",
    "historia": "tsx historia.ts",
    "construir-deno": "esbuild paquetes/protocolo/src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=deno/protocolo.js --log-level=warning",
    "publicar-guias": "npm run historia && tsx publicar-guias.ts",
    "anotar": "node bin/anotar.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
