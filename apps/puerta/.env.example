# Dónde escucha y con qué dirección se anuncia. URL_PUBLICA es la que va escrita
# en todo lo que la puerta sirve y publica, así que tiene que ser la real.
PUERTO=8787
HOST=0.0.0.0
URL_PUBLICA=https://tu-dominio.example

# Relays de los que lee y a los que publica.
RELAYS=wss://nos.lol,wss://relay.damus.io

NOMBRE=La colmena

# Prueba de trabajo que la puerta hace por sus invitados (bits, NIP-13). Bajarla
# abarata el spam para todos; subirla hace más lenta cada publicación.
POW_MINIMO=20
POW_RESPUESTA=16

# Cuánto dura una identidad prestada, cuánto puede publicar, y cuántas
# publicaciones acepta por hora desde un mismo origen.
VIDA_PASE_SEG=86400
MAX_POR_PASE=20
MAX_POR_ORIGEN_POR_HORA=12

# Cuánto sobrevive un borrador esperando el clic de una persona.
VIDA_BORRADOR_SEG=3600
