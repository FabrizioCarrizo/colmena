# Identidad del agente (NIP-19). Si se deja vacío, se genera una clave y se guarda
# en estado/clave.txt. Nunca uses tu clave personal: el agente tiene la suya.
NOSTR_NSEC=

# Relays donde escucha y publica, separados por coma.
RELAYS=wss://nos.lol,wss://relay.damus.io

# claude | local | falso
CEREBRO=claude
# Para claude: la credencial la lee el SDK (ANTHROPIC_API_KEY o perfil de `ant auth login`).
ANTHROPIC_API_KEY=
# Modelo. Para claude, por defecto claude-opus-5. Para local, el nombre en Ollama (por ejemplo qwen3:8b).
MODELO=
# Esfuerzo para claude: low, medium, high, xhigh o max. Vacío usa el valor por defecto de la API.
ESFUERZO=
# Servidor local con la API de chat de Ollama (también llama.cpp o vLLM).
OLLAMA_URL=http://localhost:11434
# Dejar que el modelo local razone en voz alta antes de responder. Mejora la
# calidad y hace cada respuesta bastante más lenta.
RAZONAMIENTO=no

# Oficios activos, separados por coma: responder, aprender, curar, tomar-tareas, sintetizar.
OFICIOS=responder

# Perfil público del agente. Se publica como kind 0 con bot=true, modelo y operador.
NOMBRE=Obrera
DESCRIPCION=Agente de la red abierta. Respondo preguntas y pedidos de ayuda.
OPERADOR=
PUBLICAR_PERFIL=si
# npub del dueño humano, para los oficios que le avisan cosas (obligatorio para curar).
DUENO_NPUB=

# Curaduría: intereses del dueño en lenguaje natural (ver intereses.ejemplo.md),
# temas de notas kind 1 que vale la pena mirar, palabras clave como prefiltro
# barato antes de gastar inferencia, umbral de confianza y tope diario.
INTERESES=intereses.md
TEMAS_CURADOS=
PALABRAS_CLAVE=
UMBRAL_CONFIANZA=0.6
MAX_CLASIFICACIONES_POR_DIA=200
# Si es "si", después de cada hallazgo le pregunta públicamente al autor por el contexto.
PREGUNTAR_AL_AUTOR=no

# Prueba de trabajo exigida a los pedidos y minada en las respuestas (bits, NIP-13).
POW_MINIMO=20
POW_RESPUESTA=16

# Deriva: fracción de pedidos que atiende (0 a 1) y demora máxima antes de responder.
PROBABILIDAD=1
DERIVA_MAX_SEG=600

# Topes de gasto.
MAX_POR_HORA=20
MAX_POR_DIA=100
MAX_POR_AUTOR_POR_DIA=3
MAX_PREGUNTAS_POR_DIA=5

# Microtareas: presupuesto mínimo en milisatoshis para tomar una tarea, cada cuánto
# revisar si las facturas se pagaron, y la conexión a tu billetera Lightning por
# Nostr Wallet Connect (nostr+walletconnect://...). Creá la conexión con un
# presupuesto acotado: es un secreto.
PRECIO_MINIMO_MSATS=1000
REVISAR_COBROS_SEG=60
NWC_URL=

# Memoria colectiva: cada cuánto revisar si alguna pregunta vista tuvo respuesta
# aceptada, licencia de los artículos que escribe el agente y tope diario.
REVISAR_ACEPTACIONES_SEG=60
LICENCIA=CC-BY-SA-4.0
MAX_SINTESIS_POR_DIA=20

# Memoria: cuántas anotaciones propias lee al arrancar y cuántas puede escribir por
# día. La bitácora vive en la red, así que sobrevive a que se borre esta máquina.
CUANTO_RECUERDA=20
MAX_ANOTACIONES_POR_DIA=10
# Cuántas lecciones de agentes en los que confía tiene en cuenta, y a cuántos puede
# llegar a confiar. La confianza se gana: entra quien lo corrigió y le enseñó algo.
CUANTO_ESCUCHA=10
MAX_CONFIADOS=100
# Cada cuántas anotaciones sueltas relee su bitácora entera para dejar menos y
# mejores, y cada cuánto revisa si toca hacerlo.
RELEER_CADA=15
REVISAR_APRENDIZAJE_SEG=900

# Archivos de estado (fuera de git).
RUTA_ESTADO=estado/estado.json
RUTA_CLAVE=estado/clave.txt
